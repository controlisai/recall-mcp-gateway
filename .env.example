# Recall MCP Gateway — Environment Variables
# Copy to .env and customize. All values are optional unless noted.

# --- Gateway Core ---
# RECALL_LOG_LEVEL=info                        # debug, info, warn, error
# RECALL_DASHBOARD_PASS_HASH=                  # bcrypt hash: htpasswd -nbBC 10 "" yourpass | cut -d: -f2
# RECALL_MAX_BODY_SIZE=10MB                    # max HTTP request body size
# RECALL_RATE_LIMIT=100                        # global per-IP rate limit (req/s, 0=disabled)
# RECALL_METRICS_ENABLED=true                  # enable Prometheus /metrics endpoint
# RECALL_SKIP_LOCAL_RULES=false                # skip local rules when engine connected
# RECALL_PRODUCT=my-gateway                    # product label for logs/audit/dashboard
# RECALL_AUDIT_PATH=/data/audit.db             # SQLite audit DB path
# RECALL_AUDIT_RETENTION=30d                   # auto-purge after this duration

# --- PostgreSQL (single-pod or multi-pod profiles) ---
# DATABASE_URL=postgres://user:pass@host:5432/recall_gateway?sslmode=require

# --- Redis (multi-pod profile only) ---
# REDIS_URL=redis://host:6379
# REDIS_PASSWORD=

# --- Approval & Security ---
# RECALL_APPROVAL_SECRET=                      # 32+ char random secret for consent encryption
# RECALL_ADMIN_KEY=                            # shared secret for /admin/v1/ endpoints
# RECALL_SLACK_SIGNING_SECRET=                 # Slack app signing secret for interactive callbacks

# --- Connected Mode (Recall Platform subscription) ---
# RECALL_API_KEY=                              # Recall SDK API key
# RECALL_SERVICE_TOKEN=                        # Recall Platform service token

# --- OpenTelemetry ---
# OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317   # OTLP collector endpoint

# --- LLM Recommendations (optional) ---
# ANTHROPIC_API_KEY=                           # for Claude-powered recommendations
# OPENAI_API_KEY=                              # alternative: OpenAI-powered recommendations

# --- Upstream MCP Server Auth (referenced in config.yaml as ${VAR}) ---
# MY_SERVER_TOKEN=                             # bearer token for upstream server
# MY_SERVER_PASSWORD=                          # basic auth password for upstream server
# MY_OAUTH_CLIENT_SECRET=                      # OAuth client secret for upstream server
